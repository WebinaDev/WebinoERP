{
	servers {
		protocols h1 h2
	}
	email {$CADDY_ACME_EMAIL:admin@webinaagency.ir}
}

(security_headers) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

(app_routes) {
	encode zstd gzip

	@nextStatic path /_next/static/*
	header @nextStatic Cache-Control "public, max-age=31536000, immutable"

	@publicStatic path /fonts/* /brand/*
	header @publicStatic Cache-Control "public, max-age=31536000, immutable"

	@api path /api/*
	header @api Cache-Control "no-store"

	handle /api/* {
		reverse_proxy backend:8080 {
			header_up Host {host}
		}
	}

	handle /app/* {
		reverse_proxy ws:8081
	}

	handle /docs* {
		reverse_proxy docs:80
	}

	handle {
		reverse_proxy frontend:3000
	}
}

# Domains are fixed here (env placeholders were expanding to ":80" and skipping HTTPS).
# Change hostnames only when intentionally moving the site — keep caddy_data volume forever.
webinaagency.ir, www.webinaagency.ir {
	import security_headers
	import app_routes
}

# Per-tenant site snippets written by LocalSameVpsProvisioner
import /etc/caddy/sites/*.caddy
