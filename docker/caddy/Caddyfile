{
	servers {
		protocols h1 h2
	}
	email {$CADDY_ACME_EMAIL:admin@webina.dev}
	# Let's Encrypt only (no implicit ZeroSSL fallback issuer)
	cert_issuer acme
}

(security_headers) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Product fingerprint (replaces any PHP/Next X-Powered-By)
		X-Powered-By "Webina ERP"
		-Server
	}
}

(app_routes) {
	encode zstd gzip

	@nextStatic path /_next/static/*
	header @nextStatic Cache-Control "public, max-age=31536000, immutable"

	@publicStatic path /fonts/* /brand/*
	header @publicStatic Cache-Control "public, max-age=31536000, immutable"

	@api path /api/*
	header @api Cache-Control "no-store"

	@publicMedia path /marketing/* /currency/*
	header @publicMedia Cache-Control "public, max-age=604800"

	@storage path /storage/*
	header @storage Cache-Control "public, max-age=86400"

	# Laravel public disk (durable host dir /var/lib/webino/storage-public).
	handle_path /storage/* {
		root * /srv/storage
		file_server
	}

	handle /api/* {
		reverse_proxy erp-backend:8080 {
			header_up Host {host}
		}
	}

	handle /app/* {
		reverse_proxy ws:8081
	}

	handle /docs* {
		reverse_proxy docs:80
	}

	handle {
		# Harmless product marker cookie; added at the proxy so Next page caching is untouched.
		@pageReq not path /_next/* /lucide-icon/*
		header @pageReq +Set-Cookie "webina_site=erp; Path=/; Max-Age=31536000; SameSite=Lax; Secure"
		# Public pages go through the edge micro-cache (docker/edge/nginx.conf).
		# Rollback: change erp-edge:8080 back to erp-frontend:3000 and reload Caddy.
		reverse_proxy erp-edge:8080
	}
}

# Primary apex — keep caddy_data volume forever when changing hostnames.
webina.dev, www.webina.dev {
	import security_headers
	import app_routes
}

# Contact hub (same Next app; host rewrite in middleware → /connect)
contact.webina.dev {
	import security_headers
	import app_routes
}

# Legacy apex → permanent redirect to webina.dev (preserve path + query)
webinaagency.ir, www.webinaagency.ir {
	import security_headers
	redir https://webina.dev{uri} permanent
}

# Tenant performance defaults (imported by every tenant snippet from TenantSiteStack).
(tenant_perf) {
	encode zstd gzip
	@tNextStatic path /_next/static/*
	header @tNextStatic >Cache-Control "public, max-age=31536000, immutable"
	# /_next/image + storage images: long Cache-Control is set by edge nginx (:8081) on 200 only,
	# so a 400/404 is never cached by browsers for 30 days.
	@tNextImage path /_next/image*
	header @tNextImage >Vary Accept
	@tFonts path /fonts/* *.woff2 *.woff *.ttf
	header @tFonts >Cache-Control "public, max-age=31536000, immutable"
	@tInline path /inline-media/*
	header @tInline >Cache-Control "public, max-age=31536000, immutable"
}

# Tenant image cache: /_next/image + storage images via edge nginx (docker/edge/nginx.conf :8081).
# Usage: import tenant_img ws-<slug>
(tenant_img) {
	handle /_next/image* {
		reverse_proxy erp-edge:8081 {
			header_up Host {host}
			header_up X-Webina-Tenant {args[0]}
		}
	}
	@tImgFile path_regexp tImgFile (?i)^/(storage|uploads|media)/.+\.(webp|avif|jpe?g|png|gif|svg)$
	handle @tImgFile {
		reverse_proxy erp-edge:8081 {
			header_up Host {host}
			header_up X-Webina-Tenant {args[0]}
		}
	}
	# Anonymous HTML microcache (edge nginx :8082, key host+URL). Requests with any
	# cookie or Authorization header, non-GET, API/Next/file paths go straight to the tenant.
	@tHtml {
		method GET HEAD
		not path /api/* /_next/* /storage/* /uploads/* /inline-media/* /fonts/* /webino-revalidate*
		not path_regexp \.[A-Za-z0-9]{1,5}$
		not header Cookie *
		not header Authorization *
	}
	handle @tHtml {
		reverse_proxy erp-edge:8082 {
			header_up Host {host}
			header_up X-Webina-Tenant {args[0]}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}

# Per-tenant site snippets written by LocalSameVpsProvisioner
import /etc/caddy/sites/*.caddy
