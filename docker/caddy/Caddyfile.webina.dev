{
	servers {
		protocols h1 h2
	}
	email webmaster@webina.dev
}

(security_headers) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

(app_routes) {
	encode zstd gzip

	@nextStatic path /_next/static/*
	header @nextStatic Cache-Control "public, max-age=31536000, immutable"

	@publicStatic path /fonts/* /brand/*
	header @publicStatic Cache-Control "public, max-age=31536000, immutable"

	@api path /api/*
	header @api Cache-Control "no-store"

	handle /api/* {
		reverse_proxy erp-backend:8080 {
			header_up Host {host}
		}
	}

	handle /app/* {
		reverse_proxy ws:8081
	}

	handle /docs* {
		reverse_proxy docs:80
	}

	handle {
		reverse_proxy erp-frontend:3000
	}
}

# TEMP until Let's Encrypt rate limit resets (~2026-09-05 UTC).
# Browsers will warn (self-signed). After the date, replace `tls internal`
# with nothing (Caddy auto LE) — and NEVER delete the caddy_data volume.
webina.dev, www.webina.dev {
	tls internal
	import security_headers
	import app_routes
}
