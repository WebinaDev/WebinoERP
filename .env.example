# WebinoERM root environment (Docker Compose)
# Copy to .env: cp .env.example .env

COMPOSE_PROJECT_NAME=webinoerm

# Ports (host) — WEB_* is canonical; NGINX_* kept as aliases for older docs
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Database (postgres service) — install.sh replaces CHANGE_ME with random secrets
POSTGRES_DB=webina_crm
POSTGRES_USER=webino
POSTGRES_PASSWORD=CHANGE_ME

# Redis — install.sh replaces CHANGE_ME with a random secret
REDIS_PASSWORD=CHANGE_ME

# Reverb — install.sh replaces CHANGE_ME values
REVERB_APP_ID=webino
REVERB_APP_KEY=CHANGE_ME
REVERB_APP_SECRET=CHANGE_ME

# Backend — copy backend/.env.example to backend/.env and set APP_KEY
# Frontend — copy frontend/.env.example to frontend/.env.local
