+<?php
+
+namespace App\Services\Provision;
+
+use Illuminate\Support\Facades\Http;
+use Throwable;
+
+/**
+ * Tells ERP that a site admin read or dismissed a notice.
+ * Failure stays on the tenant: the inbox action still succeeds.
+ */
+class ErpAnnouncementReceipt
+{
+    public static function report(?string $externalKey, string $event): void
+    {
+        if (! is_string($externalKey) || ! str_starts_with($externalKey, 'erp-site-announcement:')) {
+            return;
+        }
+        if (! in_array($event, ['read', 'dismissed', 'delivered'], true)) {
+            return;
+        }
+
+        $base = rtrim((string) config('services.webino.base_url'), '/');
+        $token = (string) env('TENANT_PROVISION_TOKEN', '');
+        $secret = (string) config('services.webino.provision_hmac_secret', '');
+        if ($base === '' || $token === '' || $secret === '') {
+            return;
+        }
+
+        $body = json_encode([
+            'external_key' => $externalKey,
+            'event' => $event,
+            'occurred_at' => now()->toIso8601String(),
+        ], JSON_UNESCAPED_UNICODE);
+        if ($body === false) {
+            return;
+        }
+
+        try {
+            Http::withHeaders([
+                'X-Provision-Token' => $token,
+                'X-Provision-Signature' => hash_hmac('sha256', $body, $secret),
+                'Accept' => 'application/json',
+                'Content-Type' => 'application/json',
+            ])->withBody($body, 'application/json')
+                ->timeout(8)
+                ->post($base.'/api/v1/site-builder/sync/announcements/receipt');
+        } catch (Throwable) {
+            // The tenant inbox is the source of read state. ERP counts are best effort.
+        }
+    }
+}
