+<?php
+
+namespace Tests\Feature;
+
+use App\Models\User;
+use App\Models\UserNotification;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Http;
+use Laravel\Sanctum\Sanctum;
+use Tests\TestCase;
+
+class ErpSiteAnnouncementIngestTest extends TestCase
+{
+    use RefreshDatabase;
+
+    public function test_hmac_push_reaches_admins_and_dismiss_hides_it(): void
+    {
+        Http::fake();
+        $tenant = $this->createTenant();
+        $admin = User::factory()->create(['tenant_id' => $tenant->id, 'role' => 'admin']);
+        User::factory()->create(['tenant_id' => $tenant->id, 'role' => 'customer']);
+
+        $payload = [
+            'version' => 1,
+            'announcement' => [
+                'external_key' => 'erp-site-announcement:7',
+                'action' => 'upsert',
+                'level' => 'info',
+                'title_fa' => 'اطلاعیه نگهداری',
+                'body_fa' => 'امشب یک ساعت توقف داریم.',
+                'title_en' => 'Maintenance',
+                'body_en' => 'One hour pause tonight.',
+            ],
+        ];
+        $body = json_encode($payload, JSON_UNESCAPED_UNICODE);
+        $secret = (string) env('WEBINO_PROVISION_HMAC_SECRET');
+
+        $this->call('POST', '/api/v1/provision/announcements', [], [], [], [
+            'CONTENT_TYPE' => 'application/json',
+            'HTTP_ACCEPT' => 'application/json',
+            'HTTP_X_PROVISION_TOKEN' => (string) env('TENANT_PROVISION_TOKEN'),
+            'HTTP_X_PROVISION_SIGNATURE' => hash_hmac('sha256', (string) $body, $secret),
+        ], (string) $body)->assertOk()->assertJsonPath('data.recipients', 1);
+
+        $this->assertSame(1, UserNotification::query()->where('user_id', $admin->id)->count());
+        $this->assertSame(0, UserNotification::query()->where('type', 'erp_announcement')->where('user_id', '!=', $admin->id)->count());
+
+        $same = $this->call('POST', '/api/v1/provision/announcements', [], [], [], [
+            'CONTENT_TYPE' => 'application/json',
+            'HTTP_ACCEPT' => 'application/json',
+            'HTTP_X_PROVISION_TOKEN' => (string) env('TENANT_PROVISION_TOKEN'),
+            'HTTP_X_PROVISION_SIGNATURE' => hash_hmac('sha256', (string) $body, $secret),
+        ], (string) $body);
+        $same->assertOk();
+        $this->assertSame(1, UserNotification::query()->count());
+
+        Sanctum::actingAs($admin);
+        $list = $this->getJson('/api/v1/account/notifications');
+        $list->assertOk()->assertJsonPath('data.unread', 1);
+        $id = $list->json('data.items.0.id');
+
+        $this->postJson('/api/v1/account/notifications/'.$id.'/read')->assertOk();
+        $this->postJson('/api/v1/account/notifications/'.$id.'/dismiss')->assertOk();
+        $this->getJson('/api/v1/account/notifications')->assertOk()->assertJsonPath('data.total', 0);
+
+        $changed = $payload;
+        $changed['announcement']['body_fa'] = 'زمان توقف عوض شد.';
+        $changedBody = json_encode($changed, JSON_UNESCAPED_UNICODE);
+        $this->call('POST', '/api/v1/provision/announcements', [], [], [], [
+            'CONTENT_TYPE' => 'application/json',
+            'HTTP_ACCEPT' => 'application/json',
+            'HTTP_X_PROVISION_TOKEN' => (string) env('TENANT_PROVISION_TOKEN'),
+            'HTTP_X_PROVISION_SIGNATURE' => hash_hmac('sha256', (string) $changedBody, $secret),
+        ], (string) $changedBody)->assertOk();
+
+        $this->getJson('/api/v1/account/notifications')
+            ->assertOk()
+            ->assertJsonPath('data.unread', 1)
+            ->assertJsonPath('data.items.0.body', 'زمان توقف عوض شد.');
+
+        $revoke = [
+            'version' => 1,
+            'announcement' => [
+                'external_key' => 'erp-site-announcement:7',
+                'action' => 'revoke',
+            ],
+        ];
+        $revokeBody = json_encode($revoke, JSON_UNESCAPED_UNICODE);
+        $this->call('POST', '/api/v1/provision/announcements', [], [], [], [
+            'CONTENT_TYPE' => 'application/json',
+            'HTTP_ACCEPT' => 'application/json',
+            'HTTP_X_PROVISION_TOKEN' => (string) env('TENANT_PROVISION_TOKEN'),
+            'HTTP_X_PROVISION_SIGNATURE' => hash_hmac('sha256', (string) $revokeBody, $secret),
+        ], (string) $revokeBody)->assertOk();
+
+        $this->getJson('/api/v1/account/notifications')->assertOk()->assertJsonPath('data.total', 0);
+    }
+
+    public function test_bad_signature_is_rejected(): void
+    {
