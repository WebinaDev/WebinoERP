@@ -0,0 +1,66 @@
+<?php
+
+namespace App\Console\Commands;
+
+use App\Services\Provision\ErpSiteAnnouncementIngest;
+use Illuminate\Console\Command;
+use Illuminate\Support\Facades\Http;
+use Throwable;
+
+class PullErpAnnouncementsCommand extends Command
+{
+    protected $signature = 'erp:pull-announcements';
+
+    protected $description = 'Pull site-admin notices from ERP into the dashboard inbox.';
+
+    public function handle(ErpSiteAnnouncementIngest $ingest): int
+    {
+        $base = rtrim((string) config('services.webino.base_url'), '/');
+        $token = (string) env('TENANT_PROVISION_TOKEN', '');
+        $secret = (string) config('services.webino.provision_hmac_secret', '');
+        if ($base === '' || $token === '' || $secret === '') {
+            $this->warn('ERP pull skipped: base URL, token, or HMAC secret is empty.');
+
+            return self::SUCCESS;
+        }
+
+        $body = json_encode(new \stdClass, JSON_UNESCAPED_UNICODE);
+        try {
+            $response = Http::withHeaders([
+                'X-Provision-Token' => $token,
+                'X-Provision-Signature' => hash_hmac('sha256', (string) $body, $secret),
+                'Accept' => 'application/json',
+                'Content-Type' => 'application/json',
+            ])->withBody((string) $body, 'application/json')
+                ->timeout(20)
+                ->post($base.'/api/v1/site-builder/sync/announcements/pull');
+        } catch (Throwable $e) {
+            $this->error($e->getMessage());
+
+            return self::FAILURE;
+        }
+
+        if (! $response->successful()) {
+            $this->error('ERP pull failed: HTTP '.$response->status());
+
+            return self::FAILURE;
+        }
+
+        $rows = $response->json('data.announcements') ?? [];
+        $applied = 0;
+        if (is_array($rows)) {
+            foreach ($rows as $row) {
+                $announcement = is_array($row) ? ($row['announcement'] ?? $row) : null;
+                if (! is_array($announcement)) {
+                    continue;
+                }
+                $ingest->apply($announcement);
+                $applied++;
+            }
+        }
+
+        $this->info('applied '.$applied);
+
+        return self::SUCCESS;
+    }
+}
