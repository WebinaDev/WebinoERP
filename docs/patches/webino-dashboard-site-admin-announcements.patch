+<?php
+
+namespace App\Http\Controllers\Api\V1;
+
+use App\Http\Controllers\Controller;
+use App\Services\Provision\ErpSiteAnnouncementIngest;
+use Illuminate\Http\Exceptions\HttpResponseException;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use InvalidArgumentException;
+
+class ErpAnnouncementIngestController extends Controller
+{
+    public function store(Request $request, ErpSiteAnnouncementIngest $ingest): JsonResponse
+    {
+        $this->assertProvisionAuth($request);
+
+        $data = $request->validate([
+            'version' => 'required|integer|in:1',
+            'announcement' => 'required|array',
+            'announcement.external_key' => ['required', 'string', 'regex:/^erp-site-announcement:\d+$/'],
+            'announcement.action' => 'required|string|in:upsert,revoke',
+            'announcement.level' => 'nullable|string|max:16',
+            'announcement.title_fa' => 'nullable|string|max:191',
+            'announcement.title_en' => 'nullable|string|max:191',
+            'announcement.body_fa' => 'nullable|string|max:20000',
+            'announcement.body_en' => 'nullable|string|max:20000',
+            'announcement.published_at' => 'nullable|date',
+            'announcement.expires_at' => 'nullable|date',
+        ]);
+
+        try {
+            $result = $ingest->apply($data['announcement']);
+        } catch (InvalidArgumentException) {
+            return response()->json(['message' => 'اطلاعیه نامعتبر است.'], 422);
+        }
+
+        return response()->json(['data' => $result]);
+    }
+
+    protected function assertProvisionAuth(Request $request): void
+    {
+        $token = (string) $request->header('X-Provision-Token', '');
+        $expected = (string) env('TENANT_PROVISION_TOKEN', '');
+        if ($expected === '' || ! hash_equals($expected, $token)) {
+            throw new HttpResponseException(
+                response()->json(['message' => 'توکن پروویژن نامعتبر است.'], 403)
+            );
+        }
+
+        $secret = (string) config('services.webino.provision_hmac_secret', '');
+        if ($secret === '') {
+            throw new HttpResponseException(
+                response()->json(['message' => 'کلید امضای پروویژن تنظیم نشده است.'], 503)
+            );
+        }
+
+        $signature = (string) $request->header('X-Provision-Signature', '');
+        $body = $request->getContent();
+        if ($signature === '' || ! hash_equals(hash_hmac('sha256', $body, $secret), $signature)) {
+            throw new HttpResponseException(
+                response()->json(['message' => 'امضای درخواست نامعتبر است.'], 403)
+            );
+        }
+    }
+}
