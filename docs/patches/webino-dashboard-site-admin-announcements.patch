@@ -0,0 +1,123 @@
+<?php
+
+namespace App\Services\Provision;
+
+use App\Models\Tenant;
+use App\Models\User;
+use App\Models\UserNotification;
+use Illuminate\Support\Collection;
+use InvalidArgumentException;
+
+/**
+ * Stores an ERP site-admin notice on each admin's dashboard inbox.
+ * Same external_key updates the text. A text change is unread again.
+ * Identical retries keep read and dismiss state.
+ */
+class ErpSiteAnnouncementIngest
+{
+    /**
+     * @param  array<string, mixed>  $announcement
+     * @return array<string, mixed>
+     */
+    public function apply(array $announcement): array
+    {
+        $key = (string) ($announcement['external_key'] ?? '');
+        if (! preg_match('/^erp-site-announcement:\d+$/', $key)) {
+            throw new InvalidArgumentException('external_key');
+        }
+
+        $tenant = Tenant::query()->firstOrFail();
+        $action = (string) ($announcement['action'] ?? 'upsert');
+        if ($action === 'revoke' || $this->expired($announcement)) {
+            $this->revoke($tenant->id, $key);
+
+            return ['ok' => true, 'action' => 'revoke', 'external_key' => $key];
+        }
+
+        $title = trim((string) ($announcement['title_fa'] ?? ''));
+        if ($title === '') {
+            $title = trim((string) ($announcement['title_en'] ?? ''));
+        }
+        $body = trim((string) ($announcement['body_fa'] ?? ''));
+        if ($body === '') {
+            $body = trim((string) ($announcement['body_en'] ?? ''));
+        }
+        if ($title === '') {
+            throw new InvalidArgumentException('title');
+        }
+
+        $users = $this->admins($tenant->id);
+        foreach ($users as $user) {
+            $row = UserNotification::query()->firstOrNew([
+                'user_id' => $user->id,
+                'external_key' => $key,
+            ]);
+            $changed = $row->exists && ($row->title !== $title || (string) $row->body !== $body);
+            $row->tenant_id = $tenant->id;
+            $row->type = 'erp_announcement';
+            $row->title = $title;
+            $row->body = $body;
+            $row->link = '';
+            if (! $row->exists) {
+                $row->created_at = now();
+                $row->read_at = null;
+                $row->dismissed_at = null;
+            } elseif ($changed) {
+                $row->read_at = null;
+                $row->dismissed_at = null;
+            }
+            $row->save();
+        }
+
+        return [
+            'ok' => true,
+            'action' => 'upsert',
+            'external_key' => $key,
+            'recipients' => $users->count(),
+        ];
+    }
+
+    /**
+     * @param  array<string, mixed>  $announcement
+     */
+    private function expired(array $announcement): bool
+    {
+        $expires = $announcement['expires_at'] ?? null;
+        if (! is_string($expires) || $expires === '') {
+            return false;
+        }
+
+        return strtotime($expires) !== false && strtotime($expires) < time();
+    }
+
+    private function revoke(int $tenantId, string $key): void
+    {
+        UserNotification::query()
+            ->where('tenant_id', $tenantId)
+            ->where('external_key', $key)
+            ->whereNull('dismissed_at')
+            ->update([
+                'dismissed_at' => now(),
+                'read_at' => now(),
+            ]);
+    }
+
+    /**
+     * @return Collection<int, User>
+     */
+    private function admins(int $tenantId): Collection
+    {
+        $admins = User::query()
+            ->where('tenant_id', $tenantId)
+            ->whereIn('role', ['admin', 'staff'])
+            ->get();
+        if ($admins->isNotEmpty()) {
+            return $admins;
+        }
+
+        return User::query()
+            ->where('tenant_id', $tenantId)
+            ->where('role', 'shop_manager')
+            ->get();
+    }
+}
