APP_NAME=WebinoERM
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Asia/Tehran

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Docker Compose defaults (see ../docker-compose.yml)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=webina_crm
DB_USERNAME=webino
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=webino_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
# Main compose / prod: match redis --requirepass (default CHANGE_ME).
# aaPanel stack overrides REDIS_PASSWORD to empty (Redis has no auth there).
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@webino.local"
MAIL_FROM_NAME="${APP_NAME}"

# Laravel Reverb (WebSocket) — Octane occupies 8080; Reverb listens on 8081
REVERB_APP_ID=webino
REVERB_APP_KEY=CHANGE_ME
REVERB_APP_SECRET=CHANGE_ME
REVERB_HOST=0.0.0.0
REVERB_PORT=8081
REVERB_SCHEME=http

OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false

VITE_APP_NAME="${APP_NAME}"

# SMS OTP provider: melipayamak | parsgreen | log | stub | disabled
SMS_PROVIDER=log

# Melipayamak (REST panel)
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_SENDER=

# ParsGreen (optional env fallback)
PARSGREEN_API_KEY=

# Bale business bot
BALE_BOT_TOKEN=
BALE_WEBHOOK_SECRET=

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Git webhook repo allowlist (comma-separated hosts)
GIT_WEBHOOK_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org,gitea.com,codeberg.org

# ModirPayamak (IPPanel Edge)
MODIRPAYAMAK_API_KEY=
MODIRPAYAMAK_MOCK=false

# Google Calendar and Gmail OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT=

# Microsoft Graph calendar and mail OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_CALENDAR_REDIRECT=

# Optional e-invoice submit hook (used when MOADIAN_BASE_URL is empty)
MOADIAN_HOOK_URL=
MOADIAN_BASE_URL=
MOADIAN_SANDBOX=false
MOADIAN_SANDBOX_BASE_URL=https://sandbox.moadian.ir
MOADIAN_CLIENT_ID=
MOADIAN_CLIENT_SECRET=
MOADIAN_FISCAL_ID=
MOADIAN_ECONOMIC_CODE=
MOADIAN_PRIVATE_KEY=
MOADIAN_PRIVATE_KEY_PATH=
MOADIAN_RETRY_TIMES=5

# Mail spam, quote approval, SAML IdP, sandbox, social publish
MAIL_SPAM_THRESHOLD=3
MAIL_SPAM_DOMAINS=
CPQ_APPROVAL_PERCENT=25
SAML_IDP_CERT=
SAML_IDP_KEY=
WEBINO_SANDBOX=false
INSTAGRAM_GRAPH_BASE=https://graph.facebook.com/v21.0
LINKEDIN_API_BASE=https://api.linkedin.com

# ERP AI assist (falls back to heuristics when empty)
GAPGPT_API_KEY=
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Iranian payment gateways. Leave secrets empty. The ERP settings page
# (درگاه‌های پرداخت) is the source of truth for enable, sandbox, fee, and modes.
# Env values are used only when that field has not been saved yet.
PAYMENT_CALLBACK_SECRET=
PAYMENT_CALLBACK_BASE_URL=
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_ENABLED=false
SNAPPPAY_CLIENT_ID=
SNAPPPAY_CLIENT_SECRET=
SNAPPPAY_USERNAME=
SNAPPPAY_PASSWORD=
SNAPPPAY_BASE_URL=
SNAPPPAY_SANDBOX=true
SNAPPPAY_ENABLED=false
DIGIPAY_CLIENT_ID=
DIGIPAY_CLIENT_SECRET=
DIGIPAY_USERNAME=
DIGIPAY_PASSWORD=
DIGIPAY_BASE_URL=
DIGIPAY_SANDBOX=true
DIGIPAY_ENABLED=false
TOROBPAY_CLIENT_ID=
TOROBPAY_CLIENT_SECRET=
TOROBPAY_USERNAME=
TOROBPAY_PASSWORD=
TOROBPAY_BASE_URL=
TOROBPAY_SANDBOX=true
TOROBPAY_ENABLED=false

# Platform local shell exec (default off — never enable on shared hosts)
PLATFORM_ALLOW_LOCAL_EXEC=false

# Tenant Dashboard ↔ ERP integration (also set public_crm_url in hosting settings UI — must NOT be localhost)
# Optional shared service auth for Dashboard↔ERP (NOT license identity).
# Entitlement is domain (+ product). license/check accepts unsigned domain-status (rate-limited).
WEBINOCRM_LICENSE_HMAC_SECRET=
# Optional env fallback for consultation ingest; prefer CoreHostingSetting.provision_webhook_secret
WEBINO_PROVISION_HMAC_SECRET=
