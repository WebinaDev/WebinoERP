{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Webino Hardware Gateway",
  "version": "1.0.0",
  "identifier": "com.webino.hardwaregateway",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Webino Hardware Gateway - تنظیمات و وضعیت",
        "width": 800,
        "height": 600,
        "resizable": true,
        "visible": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "tooltip": "Webino Hardware Gateway (فعال روی پورت 9100)"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
